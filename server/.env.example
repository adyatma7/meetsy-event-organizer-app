# ==================================
# Meetsy Event Management System
# Environment Variables
# ==================================

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# JWT
JWT_SECRET=your_long_random_secret_here_min_32_chars

# Admin credentials (used by seed script)
ADMIN_EMAIL=admin@meetsy.com
ADMIN_PASSWORD=change_this_password

# Email adapter (swap by changing EMAIL_PROVIDER)
EMAIL_PROVIDER=resend
# Options: resend | brevo | smtp

RESEND_API_KEY=re_xxxxxxxxxxxx
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=app_password_here

# AI adapter (swap by changing AI_PROVIDER)
AI_PROVIDER=ollama
# Options: ollama | gemini

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxx

# App
CLIENT_URL=http://localhost:5173
PORT=3000
NODE_ENV=development
